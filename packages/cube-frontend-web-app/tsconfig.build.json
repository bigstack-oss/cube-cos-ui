{
  "extends": "./tsconfig.app.json",
  /**
   * We have two separate `i18next.d.ts` declaration files — one for the web-app and one for the ui-library.
   * However, this causes a conflict and results in a build failure when building the web-app package.
   *
   * Since i18n types are already validated during the `tsc` step,
   * we can safely exclude the web-app declaration file here to prevent the build from failing.
   */
  "exclude": ["./src/i18n/i18next.d.ts"]
}
